# ────────────────────────────────────────────────────────────────
# Application Settings
# ────────────────────────────────────────────────────────────────
APP_NAME=G6-PNC-Student-Score
APP_ENV=local                          # local | testing | production
APP_KEY=                               # Run `php artisan key:generate` after first clone
APP_DEBUG=true                         # Set to false in production
APP_URL=http://localhost               # Backend URL

# Frontend URL for CORS and Sanctum SPA authentication
FRONTEND_URL=http://localhost:5173

# ────────────────────────────────────────────────────────────────
# Locale & Maintenance
# ────────────────────────────────────────────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file            # file | database
# APP_MAINTENANCE_STORE=database

# ────────────────────────────────────────────────────────────────
# PHP & Performance
# ────────────────────────────────────────────────────────────────
PHP_CLI_SERVER_WORKERS=4               # Dev server concurrency
BCRYPT_ROUNDS=12                       # Password hashing cost (10-14)

# ────────────────────────────────────────────────────────────────
# Logging
# ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                        # debug | info | notice | warning | error | critical

# ────────────────────────────────────────────────────────────────
# Database (MySQL)
# ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=student_score_db
DB_USERNAME=root
DB_PASSWORD=

# ────────────────────────────────────────────────────────────────
# Session & Authentication
# ────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120                   # Minutes until session expires
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Sanctum: domains allowed for SPA cookie-based authentication
# Include both with and without port for different dev scenarios
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173

# CORS: comma-separated list of allowed frontend origins
# Must match VITE_API_BASE_URL origin on the frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ────────────────────────────────────────────────────────────────
# Queue, Cache & Broadcast
# ────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database              # Use `php artisan queue:work` to process jobs
CACHE_STORE=database                   # file | database | redis | memcached
# CACHE_PREFIX=

# ────────────────────────────────────────────────────────────────
# Redis (optional — only if CACHE_STORE or QUEUE_CONNECTION = redis)
# ────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ────────────────────────────────────────────────────────────────
# Mail (used for password reset emails)
# ────────────────────────────────────────────────────────────────
MAIL_MAILER=log                        # log | smtp | sendmail | mailgun | ses
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ────────────────────────────────────────────────────────────────
# AWS (optional — only if using SES for mail)
# ────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ────────────────────────────────────────────────────────────────
# Vite (frontend build-time env vars exposed via blade template)
# ────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ────────────────────────────────────────────────────────────────
# Google OAuth 2.0 (for Google Sheets integration)
# ────────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Enable the Google Sheets API: https://console.cloud.google.com/apis/library/sheets.googleapis.com
# Set OAuth consent screen to "External" for dev, add your email as test user
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                   # Must match Google Cloud Console redirect URI
